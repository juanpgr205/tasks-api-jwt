{
  "info": {
    "name": "Tarea JWT + Usuarios - Tasks API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Pasos 5, 6 y 7: CRUD validado, Swagger y autenticación JWT. Ejecutar las carpetas en orden con Runner. El registro genera un email de prueba nuevo; el login guarda el token y crear tarea guarda taskId. Solo se elimina la tarea creada en esa ejecución. No contiene claves de Supabase ni JWT_SECRET. Para token vencido: seguir POSTMAN.md."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    {
      "key": "email",
      "value": "",
      "type": "string"
    },
    {
      "key": "password",
      "value": "ClavePruebaJWT2026!",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "invalidToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "taskId",
      "value": "",
      "type": "string"
    }
  ],
