                  "if (pm.response.code === 200) { const token=pm.response.json().accessToken; pm.collectionVariables.set('token',token); const parts=token.split('.'); parts[2]=(parts[2][0]==='a'?'b':'a')+parts[2].slice(1); pm.collectionVariables.set('invalidToken',parts.join('.')); }"
